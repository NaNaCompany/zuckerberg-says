[{"id":"archive-1790","post_id":"1790","platform":"threads","author":"zuck","original_url":"https://www.threads.net/@zuck/post/CzrPjK7pR1g","published_at":null,"published_date":"2023-11-15","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1790/","text":"We're bringing Llama 2 to @microsoft's Azure AI Studio through Models as a Service. Together we hope to make it easier for developers to adopt these models and build new generative AI applications.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.threads.net/@zuck/post/CzrPjK7pR1g","text_truncated":false},{"id":"archive-1789","post_id":"1789","platform":"threads","author":"zuck","original_url":"https://www.threads.net/@zuck/post/Czrr520PZfh","published_at":null,"published_date":"2023-11-15","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1789/","text":"Testing a way to categorize your posts with a tag. Starting in Australia with more countries coming soon.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.threads.net/@zuck/post/Czrr520PZfh","text_truncated":false},{"id":"archive-1779","post_id":"1779","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10115344599226941","published_at":null,"published_date":"2023-11-15","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1779/","text":"500 million monthly actives on WhatsApp Channels in the first 7 weeks! Great to see the WA community so engaged.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10115344599226941","text_truncated":false},{"id":"archive-1780","post_id":"1780","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10115343254571641","published_at":null,"published_date":"2023-11-13","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1780/","text":"20 years since our first date. We met at a going away party my friends threw for me in college when they thought I was about to get kicked out of school. I asked her out but told her we'd need to go...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10115343254571641","text_truncated":false},{"id":"archive-1791","post_id":"1791","platform":"threads","author":"zuck","original_url":"https://www.threads.net/@zuck/post/CziH9IgsPdD","published_at":null,"published_date":"2023-11-11","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1791/","text":"Who do you have winning tonight's fight?","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.threads.net/@zuck/post/CziH9IgsPdD","text_truncated":false},{"id":"archive-1939","post_id":"1939","platform":"instagram","author":"zuck","original_url":"https://www.instagram.com/p/CzZiaWvSH8T/","published_at":null,"published_date":"2023-11-08","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1939/","text":null,"like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"unavailable","text_source":null,"text_truncated":false},{"id":"archive-1792","post_id":"1792","platform":"threads","author":"zuck","original_url":"https://www.threads.net/@zuck/post/CzZkLa2SSys","published_at":null,"published_date":"2023-11-08","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1792/","text":"Catching up on video games while recovering from ACL surgery. The new UFC game is a bit too real. My fighter started 39 years old, but turns out every time you lose your fighter needs 9 months to recover from injuries plus time to get a new fight and then training camp. I chose the hardest difficulty and found myself sitting here at the peak of post-surgery pain with my fighter 0-8, almost 54 years old, still trying to get his first win in the UFC.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.threads.net/@zuck/post/CzZkLa2SSys","text_truncated":false},{"id":"archive-1781","post_id":"1781","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10115333194746611","published_at":null,"published_date":"2023-11-03","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1781/","text":"Tore my ACL sparring and just got out of surgery to replace it. Grateful for the doctors and team taking care of me. I was training for a competitive MMA fight early next year, but now that's delayed...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10115333194746611","text_truncated":false}]