.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10113961365418581","text_truncated":false},{"id":"archive-1444","post_id":"1444","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10113957526871061","published_at":null,"published_date":"2021-10-04","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1444/","text":"Facebook, Instagram, WhatsApp and Messenger are coming back online now. Sorry for the disruption today -- I know how much you rely on our services to stay connected with the people you care about.","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10113957526871061","text_truncated":false},{"id":"archive-1445","post_id":"1445","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10113955029116581","published_at":null,"published_date":"2021-10-03","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/1445/","text":"Sailing with Priscilla and friends. Shot on 😎","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10113955029116581","text_truncated":false}]