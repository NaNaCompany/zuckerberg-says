files_transcripts/692/","text":"If you remember one thing from F8...\n\nTransforming the camera from a feature into a platform where any developer can build for augmented reality will be an important step forward.\n\nThere is a long...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10103661342566941","text_truncated":false},{"id":"archive-932","post_id":"932","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/videos/10103658908469891/","published_at":null,"published_date":"2017-04-18","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/932/","text":"We just launched Facebook Spaces, our social virtual reality platform. With Spaces, you can hang out with your friends, teleport anywhere and do anything. \n\nThe actors enjoyed shooting this video so...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/videos/10103658908469891/","text_truncated":false},{"id":"archive-691","post_id":"691","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/photo.php?fbid=10103658596041001&set=a.529237706231.2034669.4&type=3&theater","published_at":null,"published_date":"2017-04-18","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/691/","text":null,"like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"unavailable","text_source":null,"text_truncated":false},{"id":"archive-271","post_id":"271","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/videos/vb.4/10103658355917211/","published_at":null,"published_date":"2017-04-18","date_precision":"day","source_ids":["zuckerberg-files"],"so