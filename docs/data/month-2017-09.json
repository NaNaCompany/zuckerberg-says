[{"id":"archive-763","post_id":"763","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10104074437830721","published_at":null,"published_date":"2017-09-30","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/763/","text":"Tonight concludes Yom Kippur, the holiest day of the year for Jews when we reflect on the past year and ask forgiveness for our mistakes. For those I hurt this year, I ask forgiveness and I will try...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10104074437830721","text_truncated":false},{"id":"archive-762","post_id":"762","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10104068056444071","published_at":null,"published_date":"2017-09-27","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/762/","text":"Today we're launching a way to make it easier to donate blood in India.\n\nIn an emergency, people often reach out to their community on Facebook -- asking for donors, organizing donation groups and...","like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_original_page_description","text_source":"https://www.facebook.com/zuck/posts/10104068056444071","text_truncated":false},{"id":"archive-761","post_id":"761","platform":"facebook","author":"zuck","original_url":"https://www.facebook.com/zuck/posts/10104067130714241","published_at":null,"published_date":"2017-09-27","date_precision":"day","source_ids":["zuckerberg-files"],"source_url":"https://epublications.marquette.edu/zuckerberg_files_transcripts/761/","text":"I want to respond to President Trump's tweet this morning claiming Facebook has always been against him.\n\nEvery day I work to bring people t